{
  "manifest_version": 3,
  "name": "Lightning Gifts — Send Bitcoin Gifts",
  "short_name": "Lightning Gifts",
  "description": "Create a bitcoin gift on lightning.gifts in one click: fund it from your own wallet and share a one-time claim link.",
  "version": "1.0.5",
  "browser_specific_settings": {
    "gecko": {
      "id": "lightning-gifts@lightning.gifts",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send a Lightning Gift",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "clipboardWrite", "alarms", "notifications"],
  "host_permissions": ["https://lightning.gifts/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  }
}
